# Copy to .env for `npm run dev` against a real Firebase project, and set the
# same variables in Vercel (Project -> Settings -> Environment Variables).
# For local play without any of this, use `npm run local` instead.

# --- Firebase web app (Firebase console -> Project settings -> General -> Your apps).
# Not secret: access is controlled by sign-in and firestore.rules.
PUBLIC_FIREBASE_API_KEY=""
PUBLIC_FIREBASE_AUTH_DOMAIN=""
PUBLIC_FIREBASE_PROJECT_ID=""
PUBLIC_FIREBASE_STORAGE_BUCKET=""
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
PUBLIC_FIREBASE_APP_ID=""

# --- Firebase service account (Project settings -> Service accounts -> Generate
# new private key). SECRET: never commit these or share them.
FB_PROJECT_ID=""
FB_CLIENT_EMAIL=""
# the whole "private_key" value, BEGIN/END lines included
FB_PRIVATE_KEY=""

# --- The event
PUBLIC_EVENT_NAME="let's play a game"
# ISO 8601 with a timezone offset, e.g. 2026-11-14T18:00:00+05:30.
# Before the start, the play page is closed and the home page counts down.
PUBLIC_EVENT_START=""
# After the end, answers are no longer accepted. Leave empty to never close.
PUBLIC_EVENT_END=""
# Only teams whose members all sign in with this email domain can score points
# (e.g. iitm.ac.in, which also covers smail.iitm.ac.in). Empty: everyone can.
PUBLIC_VERIFIED_EMAIL_DOMAIN=""
PUBLIC_DISCORD_URL=""
# Wrong answers a team may submit per minute before it is told to slow down.
GUESSES_PER_MINUTE="10"

# --- Optional
# Discord webhook that announces new players and teams.
WEBHOOK=""
# Error reporting with Sentry (DSN at runtime; the rest to upload source maps at build).
PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
