# Loaded by `vite dev --mode emulator` (see `npm run local`).
# Points the app at the local Firebase emulators, so no real Firebase project,
# service account or Sentry account is needed. Safe to commit: nothing secret.
FB_PROJECT_ID="demo-lets-play"
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
PUBLIC_USE_EMULATORS="true"
PUBLIC_SENTRY_DSN=""
